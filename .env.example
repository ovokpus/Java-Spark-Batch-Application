# Local-only defaults for docker compose. Copy to .env to change them. No secrets are needed.
POSTGRES_DB=batch
POSTGRES_USER=batch
POSTGRES_PASSWORD=batch
# Host ports (5433 avoids clashing with a local PostgreSQL on 5432)
POSTGRES_PORT=5433
API_PORT=8000
UI_PORT=8080
# Pipeline scope (used by docker/run-pipeline.sh)
SELLERS=Joe,Beth,Janet
DATES=20201111000000 20201112000000 20201113000000
PRODUCTS=Beer Food Car
